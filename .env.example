# Public URL of the site (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://textcrew.ai

# Neon Postgres connection string. Beta waitlist signups are stored in the waitlist_signups table.
# Use the pooled connection string from the Neon console, e.g.
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Waitlist confirmation emails (double opt-in), sent through Resend (resend.com).
# Without a key in development, the confirmation link is printed in the server log instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend
WAITLIST_FROM_EMAIL="Textcrew <hello@textcrew.in>"
