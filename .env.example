# Public URL of the site (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://textcrew.ai

# Where beta waitlist signups are sent (JSON POST: { email, channel, source, joinedAt }).
# Works with Zapier/Make webhooks, Loops, or an endpoint on your own backend.
# Leave empty in development to just log signups to the terminal.
WAITLIST_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <secret>" so your endpoint can reject other callers.
WAITLIST_WEBHOOK_SECRET=
